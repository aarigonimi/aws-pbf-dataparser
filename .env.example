# Copy to .env for local runs. Do not commit .env.
# The pipeline reads the process environment; this file documents the contract.

AWS_REGION=us-east-1

RAW_BUCKET=replace-with-raw-bucket
OUTPUT_BUCKET=replace-with-curated-bucket
RAW_KEY=region=monaco/ymd=20261108/monaco-20261108.osm.pbf

REGION_NAME=monaco
YMD=20261108
RUN_ID=local-run
OUTPUT_PREFIX=curated

MODE=all
OVERWRITE=error
PARQUET_COMPRESSION=snappy
INCLUDE_WAY_GEOMETRY=false
MAX_RECORDS_PER_FILE=250000
ROW_GROUP_SIZE=100000
LOG_LEVEL=INFO

# Optional
# LOCAL_WORK_DIR=/tmp/osm-pbf-work
# S3_MAX_ATTEMPTS=5
# S3_CONNECT_TIMEOUT=10
# S3_READ_TIMEOUT=300

# Batch submission only
# JOB_QUEUE=osm-pbf-data-lake-job-queue
# JOB_DEFINITION=osm-pbf-data-lake-job
